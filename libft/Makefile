# Target library name
NAME = libft.a

# Compiler and required flags
CC = cc
CFLAGS = -Wall -Werror -Wextra

# Archive command to create the static library
AR = ar rcs

# Directory where source files are located
SRC_DIR = src/

# List of mandatory function names (without extensions)
SRC = ft_isalpha \
  ft_isdigit \
  ft_isalnum \
  ft_isascii \
  ft_isprint \
  ft_strlen \
  ft_memset \
  ft_bzero \
  ft_memcpy \
  ft_memmove \
  ft_strlcpy \
  ft_strlcat \
  ft_toupper \
  ft_tolower \
  ft_strchr \
  ft_strrchr \
  ft_strncmp \
  ft_memchr \
  ft_memcmp \
  ft_strnstr \
  ft_atoi \
  ft_calloc \
  ft_strdup \
  ft_substr \
  ft_strjoin \
  ft_strtrim \
  ft_split \
  ft_itoa \
  ft_strmapi \
  ft_striteri \
  ft_putchar_fd \
  ft_putstr_fd \
  ft_putendl_fd \
  ft_putnbr_fd \
  ft_lstnew \
  ft_lstadd_front \
  ft_lstsize \
  ft_lstlast \
  ft_lstadd_back \
  ft_lstdelone \
  ft_lstclear \
  ft_lstiter \
  ft_lstmap \
  ft_printf.c \
  ft_print_char.c \
  ft_print_hex_lower.c \
  ft_print_hex_upper.c \
  ft_print_percent.c \
  ft_print_ptr.c \
  ft_print_putnbr.c \
  ft_print_str.c \
  ft_print_unsigned.c

# Automatically build paths for sources (src/ft_isalpha.c) and keep object files in the root
SRCS = $(addprefix $(SRC_DIR), $(addsuffix .c, $(SRC)))
OBJS = $(addsuffix .o, $(SRC))

# Default rule: builds the mandatory library
all: $(NAME)

# Pattern rule: tells Make how to compile a .c file from src/ into a .o file
%.o: $(SRC_DIR)%.c
	$(CC) $(CFLAGS) -c -o $@ $<

# Rule to build the static library
$(NAME): $(OBJS)
	$(AR) $@ $^

# Cleans up all object files generated by the Makefile
clean:
	rm -f $(OBJS)

# Cleans up object files AND the compiled library
fclean: clean
	rm -f $(NAME)

# Fully recompiles everything from scratch
re: fclean all

# Declares these targets as "phony" (not actual files), preventing conflicts
# if a file named "clean" or "all" exists in the directory.
.PHONY: all clean fclean re
